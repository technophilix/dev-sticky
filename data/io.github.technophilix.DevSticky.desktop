[Desktop Entry]
Type=Application
Name=DevSticky
GenericName=Sticky Notes
Comment=Sticky notes for developers: Markdown, code snippets, tags and search
Exec=devsticky
Icon=io.github.technophilix.DevSticky
Terminal=false
Categories=Development;
Keywords=notes;sticky;snippets;markdown;todo;
StartupNotify=true
Actions=new-note;new-todo;

[Desktop Action new-note]
Name=New Note
Exec=devsticky --new-note

[Desktop Action new-todo]
Name=New To-do List
Exec=devsticky --new-todo
